# Persistent local MongoDB (recommended for development)
# Requires the local MongoDB service to be configured as replica set 'rs0'.
MONGODB_URI=mongodb://127.0.0.1:27017/walandyo_pos?replicaSet=rs0&directConnection=true

NODE_ENV=development
PORT=3000
AUTH_SECRET=change-this-to-a-long-random-secret
COOKIE_MAX_AGE_HOURS=8
TAX_RATE=0

# IMPORTANT: Only use this for disposable/testing data.
# MONGODB_URI=embedded

# Demo data is seeded into this persistent database only when it is empty,
# or when you explicitly run `npm run seed` (which resets it).
