<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Log in · Walandyo Tapsilogan POS</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="login-body">
  <div class="login-card">
    <div class="brand-badge large">W</div>
    <h1 class="login-title">Walandyo Tapsilogan</h1>
    <p class="login-tagline">"Sabaw pa lang, ulam na!"</p>

    {{#if error}}
      <div class="alert alert-error">{{error}}</div>
    {{/if}}

    <form action="/login" method="POST" class="login-form">
      <label class="field-label" for="username">Username</label>
      <input class="field-input" type="text" id="username" name="username" autofocus required />

      <label class="field-label" for="password">Password</label>
      <input class="field-input" type="password" id="password" name="password" required />

      <button type="submit" class="btn btn-primary btn-block">Log In</button>
    </form>

    <p class="login-hint">
      Demo logins — admin/admin123 · manager1/manager123 · cashier1/cashier123 · inventory1/inventory123
    </p>
  </div>
</body>
</html>
